# Copy this file to .env.local for local dev, and set the real values as
# environment variables / secrets in whichever system deploys the container
# (Hetzner via the multi-site-hetz-cicd repo).

# Public site URL (used in metadata / absolute links)
NEXT_PUBLIC_SITE_URL=https://jacobandangelieincebu.com

# Passcode guests must enter to view the site (see middleware.ts + /login)
SITE_PASSCODE=JACOB2026

# Hetzner Object Storage — guest photo/video uploads (/photos).
# Use a NEW private bucket for the wedding, then run:
#   node --env-file=.env.local scripts/setup-bucket-cors.mjs
HETZNER_S3_ENDPOINT=https://hel1.your-objectstorage.com
HETZNER_S3_REGION=hel1
HETZNER_S3_BUCKET=jacob-angelie-wedding-2026
HETZNER_S3_ACCESS_KEY_ID=
HETZNER_S3_SECRET_ACCESS_KEY=
