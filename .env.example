# Copy this file to .env.local for local dev, and set the real values as
# environment variables / secrets in whichever system deploys the container
# (Hetzner via the multi-site-hetz-cicd repo).

# Public site URL (used in metadata / absolute links)
NEXT_PUBLIC_SITE_URL=https://wedding.prince-v.com

# Passcode guests must enter to view the site (see middleware.ts + /login)
SITE_PASSCODE=JACOB2026

# Resend — used only to email RSVP submissions, no database involved
RESEND_API_KEY=
EMAIL_FROM="Jacob & Angelie <rsvp@prince-v.com>"
RSVP_NOTIFY_TO=adaptiveworkflowconsultancy@gmail.com
